# Browser-restricted key for the Google Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=

# Use DEMO_MAP_ID during development or replace it with your own JavaScript map ID
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# Configurable because openstreetmap.org community tiles are best-effort and
# should be replaced with a hosted OSM-derived provider at production scale.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png


# Base URL of the Express API in ./server (see docker-compose.yml).
VITE_API_URL=http://localhost:4000
