# Port the API listens on. The frontend's VITE_API_URL must point here.
PORT=4000

# Connection string for PostgreSQL. Any Postgres works: the Docker container
# from docker-compose.yml (default below) or a hosted database such as Neon.
# For Neon, paste its connection string including ?sslmode=require, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://citizen:citizen_dev_password@localhost:5432/citizen_connect

# Browser origins allowed to call this API. Vite may use port 5174 when 5173
# is already occupied. Use a comma-separated list to allow several origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Folder where report photos are written. Served at /uploads/<file>.
UPLOAD_DIR=./uploads

# --- Production settings -------------------------------------------------

# Where report photos live: "database" (default, keeps the API stateless) or
# "disk" (files under UPLOAD_DIR; needs a persistent disk).
PHOTO_STORAGE=database

# Set to false in production so demo reports are never created.
SEED_DEMO_DATA=true

# Secret for moderation endpoints (/v1/admin/...). Leave empty to disable.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Set to 1 when running behind a hosting provider's proxy (Render, Railway,
# Fly.io) so rate limiting sees real visitor IPs.
TRUST_PROXY=

# Folder with the built web app. Defaults to ../dist (created by npm run build).
WEB_DIST=
